---
import { SITE } from '../site';

interface Props {
    class?: string;
    subject?: string;
    body?: string;
}
const { class: className, subject, body } = Astro.props;
const address = `${SITE.emailUser}@${SITE.emailDomain}`;
const params = new URLSearchParams();
if (subject) params.set('subject', subject);
if (body) params.set('body', body);
const query = params.toString().replace(/\+/g, '%20');
---
<!-- Vrai lien mailto dans le HTML : fonctionne sans JavaScript et reste lisible par les moteurs (audit SEO). -->
<a class={className} href={`mailto:${address}${query ? `?${query}` : ''}`}><slot>{address}</slot></a>
