---
import ResponsivePicture from './ResponsivePicture.astro';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

interface Props {
    items: CollectionEntry<'realisations'>[];
}
const { items } = Astro.props;
---
<ul class="cards grid-layout">
    {items.map((item) => (
        <li>
            <a class="card-link" href={withBase(`/realisations/${item.id}/`)}>
                <span class="sketch" data-sketch>
                    <ResponsivePicture src={item.data.image} widths={[300, 360, 600]}
                             sizes="(max-width: 640px) 45vw, 300px" alt={item.data.imageAlt} loading="lazy" />
                </span>
                <span class="card-title">{item.data.title}</span>
                <span class="card-text">{item.data.year}{item.data.materials && ` · ${item.data.materials}`}</span>
            </a>
        </li>
    ))}
</ul>
