---
import Logo from './Logo.astro';

interface Props {
    /** Lien du bouton de contact : ancre sur l'accueil, page d'accueil ailleurs. */
    contactHref?: string;
}
const { contactHref = '/#contact' } = Astro.props;
---
<nav class="site-nav" aria-label="Navigation principale">
    <div class="container">
        <a href="/" class="nav-logo">
            <Logo title="Metal Nature – accueil" />
        </a>
        <a class="button" href={contactHref}>Nous contacter</a>
    </div>
</nav>

<script>
    import { initNavTheme } from '../scripts/nav';
    initNavTheme();
</script>
