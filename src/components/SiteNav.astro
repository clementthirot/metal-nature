---
import Logo from './Logo.astro';
import { SITE } from '../site';

// Ancres en chemin absolu (/#about) : elles fonctionnent aussi depuis les sous-pages.
const path = Astro.url.pathname;
const links = [
    { href: '/realisations/', label: 'Réalisations', current: path.startsWith('/realisations') },
    { href: '/#about', label: 'Savoir-faire', current: false },
    { href: '/#author', label: "L'artisan", current: false },
];
---
<nav class="site-nav" aria-label="Navigation principale">
    <div class="container">
        <a href="/" class="nav-logo">
            <Logo title="Metal Nature – accueil" />
        </a>
        <ul class="nav-links">
            {links.map(({ href, label, current }, index) => (
                // Sur mobile, seul « Réalisations » reste affiché (pas de menu pour 3 liens).
                <li class:list={{ 'nav-link-secondary': index > 0 }}>
                    <a class="nav-link" href={href} aria-current={current ? 'page' : undefined}>{label}</a>
                </li>
            ))}
            <li class="nav-cta-desktop"><a class="button" href="/#contact">Nous contacter</a></li>
            <li class="nav-cta-mobile">
                <a class="button" href={`tel:${SITE.phone}`} aria-label={`Appeler Michel au ${SITE.phoneDisplay}`}>
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    Appeler
                </a>
            </li>
        </ul>
    </div>
</nav>

<script>
    import { initNavTheme } from '../scripts/nav';
    initNavTheme();
</script>
