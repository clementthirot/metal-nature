---
/**
 * En-tête commun des pages intérieures (review UI, B19 / B20 / B23) :
 * surtitre mono, H1, chapô, et une image d'en-tête visible dès le premier écran (mobile compris).
 * Le titre passe par le slot « title » pour permettre un accent (.strong), un seul au maximum.
 */
import ResponsivePicture from './ResponsivePicture.astro';
import type { ImageMetadata } from 'astro';

interface Props {
    eyebrow?: string;
    intro?: string;
    image?: ImageMetadata;
    imageAlt?: string;
    /** Nom de transition partagée (View Transitions) de l'image, ex. « photo-bibliotheque-pont ». */
    transitionName?: string;
}
const { eyebrow, intro, image, imageAlt = '', transitionName } = Astro.props;
---
<header class:list={['page-header', { 'has-image': image }]}>
    <div class="page-header-text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="title-1"><slot name="title" /></h1>
        {intro && <p class="page-intro">{intro}</p>}
        <slot />
    </div>
    {image && (
        <span class="page-header-media sketch" data-sketch="outline">
            <ResponsivePicture src={image} widths={[360, 720, 1024, 1440].filter((w) => w <= image.width)}
                     sizes="(max-width: 768px) calc(100vw - 32px), 33vw" alt={imageAlt} loading="eager" fetchpriority="high"
                     style={transitionName ? `view-transition-name: ${transitionName}` : undefined} data-loupe />
        </span>
    )}
</header>
