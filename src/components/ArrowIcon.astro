---
interface Props {
    direction: 'left' | 'right';
}
const { direction } = Astro.props;
const d = direction === 'left'
    ? 'M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18'
    : 'M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3';
---
<svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
     stroke="currentColor" aria-hidden="true" focusable="false" width="24" height="24">
    <path stroke-linecap="round" stroke-linejoin="round" d={d} />
</svg>
