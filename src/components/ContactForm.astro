---
import { SITE, FURNITURE_TYPES } from '../site';
const hasEndpoint = SITE.formEndpoint.length > 0;
---
<!--
    Formulaire de demande de devis (lot 3).
    - Si SITE.formEndpoint est renseigné : envoi direct (Formspree, Web3Forms…), photo jointe possible.
    - Sinon : le formulaire prépare un e-mail prérempli dans la messagerie du visiteur.
-->
<form class="contact-form" action={hasEndpoint ? SITE.formEndpoint : undefined} method="post"
      enctype="multipart/form-data" novalidate
      data-endpoint={SITE.formEndpoint} data-user={SITE.emailUser} data-domain={SITE.emailDomain}>
    <div class="form-row">
        <div class="field">
            <label for="cf-name">Nom</label>
            <input id="cf-name" name="nom" type="text" autocomplete="name" required>
        </div>
        <div class="field">
            <label for="cf-contact">E-mail ou téléphone</label>
            <input id="cf-contact" name="contact" type="text" autocomplete="email" inputmode="email" required
                   aria-describedby="cf-contact-hint">
            <p id="cf-contact-hint" class="field-hint">Pour que nous puissions vous répondre.</p>
        </div>
    </div>
    <div class="field">
        <label for="cf-type">Type de meuble</label>
        <select id="cf-type" name="type">
            <option value="">Je ne sais pas encore</option>
            {FURNITURE_TYPES.map(({ label }) => <option>{label}</option>)}
            <option>Autre</option>
        </select>
    </div>
    <div class="field">
        <label for="cf-message">Votre projet</label>
        <textarea id="cf-message" name="message" rows="4" required
                  placeholder="Pièce, dimensions approximatives, matériaux souhaités…"></textarea>
    </div>
    {hasEndpoint && (
        <div class="field">
            <label for="cf-photo">Photo de la pièce ou d'inspiration <span class="field-optional">(facultatif)</span></label>
            <input id="cf-photo" name="photo" type="file" accept="image/*">
        </div>
    )}
    <div class="form-actions">
        <button type="submit" class="button">{hasEndpoint ? 'Envoyer ma demande' : 'Préparer mon e-mail'}</button>
        <p class="form-status" role="status" aria-live="polite"></p>
    </div>
</form>

<script>
    import { initContactForm } from '../scripts/contact-form';
    initContactForm();
</script>
