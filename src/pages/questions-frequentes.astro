---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHeader from '../components/PageHeader.astro';
import portrait from '../assets/images/portrait-michel-valade-artisan-metal-bois.webp';
import CallCta from '../components/CallCta.astro';
import { FAQ } from '../data/faq';
import { breadcrumbLd } from '../utils/seo';
import '../styles/pages.css';

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: FAQ.map(({ question, answer }) => ({
            '@type': 'Question',
            name: question,
            acceptedAnswer: { '@type': 'Answer', text: answer },
        })),
    },
    breadcrumbLd([{ label: 'Accueil', href: '/' }, { label: 'Questions fréquentes', href: '/questions-frequentes/' }]),
];
---
<BaseLayout
    title="Questions fréquentes : prix, délais, matériaux | Metal Nature"
    description="Prix d'un meuble sur mesure, délais de fabrication, matériaux, zone d'intervention et entretien : les réponses de Metal Nature, artisan à Sannois (95)."
    jsonLd={jsonLd}
>
<SiteNav />
<main id="main" class="page container has-grid">
    <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Questions fréquentes' }]} />
    <PageHeader eyebrow="Prix, délais, matériaux" image={portrait}
                imageAlt="Portrait de Michel Valade, menuisier et métallier, fondateur de Metal Nature"
                intro="Prix, délais, matériaux, déplacement, entretien : ce qu'on nous demande le plus souvent.">
        <Fragment slot="title">Questions <span class="strong">fréquentes</span></Fragment>
    </PageHeader>

    <ul class="faq-list">
        {FAQ.map(({ question, answer }) => (
            <li class="faq-item">
                <details>
                    <summary>{question}</summary>
                    <p class="faq-answer">{answer}</p>
                </details>
            </li>
        ))}
    </ul>

    <CallCta title="Une autre question ?" />
</main>
<SiteFooter />
<script>
    import { initSketches } from '../scripts/sketch';
    initSketches();
</script>
</BaseLayout>
