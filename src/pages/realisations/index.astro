---
import { withBase } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHeader from '../../components/PageHeader.astro';
import '../../styles/pages.css';
import { SITE } from '../../site';

const realisations = (await getCollection('realisations', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
// Image de partage : la première réalisation (et non la console de l'accueil, absente de la liste).
const ogImage = realisations[0] ? await getImage({ src: realisations[0].data.image, format: 'jpeg', width: 1200 }) : undefined;

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'Réalisations Metal Nature',
        url: `${SITE.url}/realisations/`,
        hasPart: realisations.map((item) => ({
            '@type': 'CreativeWork',
            name: item.data.title,
            url: `${SITE.url}/realisations/${item.id}/`,
        })),
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
            { '@type': 'ListItem', position: 2, name: 'Réalisations', item: `${SITE.url}/realisations/` },
        ],
    },
];
---
<BaseLayout
    title="Réalisations : meubles bois et métal sur mesure | Metal Nature"
    description="Bibliothèques, étagères, commodes, tables basses… Découvrez les meubles sur mesure en bois et métal fabriqués par Metal Nature à Sannois (Val d'Oise)."
    jsonLd={jsonLd}
    ogImage={ogImage?.src}
    ogImageAlt={realisations[0]?.data.imageAlt}
>
<SiteNav />

<main id="main" class="container realisations-index has-grid">
    <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Réalisations' }]} />
    <PageHeader eyebrow={`Atelier à ${SITE.city}`}
                intro={`Chaque meuble est dessiné et fabriqué sur mesure dans notre atelier de ${SITE.city}, en bois et en métal. Voici une sélection de projets réalisés pour nos clients.`}>
        <Fragment slot="title">Nos <span class="strong">réalisations</span></Fragment>
    </PageHeader>

    <h2 class="eyebrow index-section-title">{realisations.length} meubles bois et métal fabriqués à {SITE.city}</h2>
    <ul class="index-grid grid-layout">
        {realisations.map((item, index) => (
            <li>
                <a class="index-card" href={withBase(`/realisations/${item.id}/`)}>
                    <span class="sketch" data-sketch={index < 4 ? 'outline' : ''}>
                        <Picture src={item.data.image} formats={['avif', 'webp']} widths={[300, 360]}
                                 sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 1024px) 33vw, 300px"
                                 alt={item.data.imageAlt} loading={index < 4 ? 'eager' : 'lazy'}
                                 style={`view-transition-name: photo-${item.id}`} />
                    </span>
                    <span class="index-card-caption">
                        <span class="index-card-title">{item.data.title}</span>
                        <span class="secondary-text mono">{item.data.year}{item.data.materials && ` · ${item.data.materials}`}</span>
                    </span>
                </a>
            </li>
        ))}
    </ul>

    <section class="index-services" aria-labelledby="index-services-title">
        <h2 id="index-services-title" class="eyebrow">Meubles sur mesure par famille</h2>
        <ul>
            {services.map((service) => (
                <li><a class="tap-link" href={withBase(`/meubles-sur-mesure/${service.id}/`)}>{service.data.title}</a></li>
            ))}
        </ul>
    </section>

    <aside class="index-cta bleed dark-theme">
        <h2 class="title-2">Un projet en tête ?</h2>
        <div class="index-cta-actions">
            <a class="button" href={`tel:${SITE.phone}`}>Appeler Michel · {SITE.phoneDisplay}</a>
            <a class="tap-link" href={withBase('/#contact')}>Autres moyens de contact</a>
        </div>
        <p class="secondary-text">Devis gratuit et sans engagement.</p>
    </aside>
</main>

<SiteFooter />

<style>
    .realisations-index {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xl);
        padding-top: calc(var(--nav-height) + var(--spacing-md));
        padding-bottom: var(--section-space);
    }
    /* Une carte par colonne de la grille, photo calée sur la ligne de gauche. */
    .index-grid {
        display: grid;
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
        row-gap: var(--spacing-xl);
        padding: 0;
        list-style: none;
    }
    .index-card {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        color: inherit;
        text-decoration: none;
    }
    .index-card :global(picture) {
        overflow: hidden;
        border-radius: var(--radius);
    }
    .index-card :global(img) {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        transition: transform .5s var(--ease-out);
    }
    .index-card:hover :global(img),
    .index-card:focus-visible :global(img) {
        transform: scale(1.03);
    }
    .index-card-caption {
        display: flex;
        flex-direction: column;
    }
    .index-card-title {
        font-size: var(--fs-body);
        font-weight: 500;
    }
    /* Mobile : une carte par ligne, pleine largeur (B20). */
    @media (max-width: 640px) {
        .index-grid > li { grid-column: 1 / -1; }
    }
    .index-cta > .title-2 {
        grid-column: 1 / span 2;
        grid-row: 1 / span 2;
        padding-right: var(--line-pad);
    }
    /* La moitié droite démarre sur la ligne du milieu : marge pour ne pas la toucher. */
    .index-cta > .index-cta-actions,
    .index-cta > .secondary-text {
        grid-column: 3 / -1;
        padding-left: var(--line-pad);
    }
    @media (max-width: 1024px) {
        .index-cta > .title-2 { grid-column: 1 / -1; grid-row: auto; }
        .index-cta > .index-cta-actions,
        .index-cta > .secondary-text { grid-column: 1 / -1; padding-left: 0; }
    }
    .index-cta-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--spacing-xs) var(--spacing-sm);
    }
    /* Encart sur la grille : titre sur la 1re moitié, actions et mention sur la 2de. */
    .index-services ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--spacing-md);
        margin-top: var(--spacing-xxs);
        padding: 0;
        list-style: none;
    }
    .index-cta {
        display: grid;
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
        align-items: center;
        row-gap: var(--spacing-xs);
        padding-block: var(--spacing-xl);
        /* Le fond déborde des lignes (.bleed) : le contenu reste aligné sur la grille. */
        margin-inline: calc(-1 * var(--bleed));
        padding-inline: calc(var(--bleed) + var(--line-pad));
        border-radius: var(--radius);
    }
</style>
<script>
    import { initSketches } from '../../scripts/sketch';
    initSketches();
</script>
</BaseLayout>
