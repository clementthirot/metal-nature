---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MailLink from '../components/MailLink.astro';
import { SITE } from '../site';
import '../styles/template.css';
import '../styles/responsive.css';

import headerImage from '../assets/images/header.png';
import contactImage from '../assets/images/contact.png';
import portrait from '../assets/images/portrait-michel-valade-artisan-metal-bois.webp';
import proposalBackground from '../assets/images/atelier-fond.jpg';

const realisations = (await getCollection('realisations', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);

const proposalBg = await getImage({ src: proposalBackground, format: 'webp', width: 1600 });

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'HomeAndConstructionBusiness',
    name: SITE.name,
    description: 'Création de meubles artisanaux sur mesure en bois et métal.',
    url: `${SITE.url}/`,
    image: `${SITE.url}/og-image.jpg`,
    logo: `${SITE.url}/logo-metal-nature.svg`,
    telephone: SITE.phone,
    founder: { '@type': 'Person', name: SITE.owner },
    address: {
        '@type': 'PostalAddress',
        addressLocality: SITE.city,
        postalCode: SITE.postalCode,
        addressRegion: SITE.region,
        addressCountry: 'FR',
    },
    areaServed: [
        { '@type': 'AdministrativeArea', name: "Val-d'Oise" },
        { '@type': 'AdministrativeArea', name: SITE.region },
    ],
    knowsAbout: ['Menuiserie', 'Métallerie', 'Mobilier sur mesure'],
};

const mailBody = "Bonjour Michel,\n\nJ'aimerais réaliser un devis avec vous au sujet de [décrivez votre projet].\nPouvez-vous me recontacter ?\n\nCordialement";
---
<BaseLayout
    title="Metal Nature • Meubles artisanaux sur mesure en bois et métal – Sannois, Val d'Oise"
    description="Meubles artisanaux sur mesure en bois et métal, fabriqués à Sannois (Val d'Oise) pour toute l'Île-de-France : dressings, bibliothèques, tables, rangements. Devis gratuit."
    jsonLd={jsonLd}
    bodyClass="page-home"
>
<SiteNav contactHref="#contact" />

<main id="main">
<header id="home" class="container">
    <h1 class="sr-only">Metal Nature, meubles artisanaux sur mesure en bois et métal à Sannois (Val d'Oise)</h1>
    <p class="animation-container" aria-hidden="true">
        <span class="title-1 title-line">La touche authentique</span>
    </p>
    <p class="animation-container" aria-hidden="true">
        <span class="title-1 title-line strong">à votre intérieur</span>
    </p>
    <div class="header-content">
        <p class="header-caption" aria-hidden="true">Faites défiler l'écran</p>
        <Image id="headerImage" src={headerImage} widths={[350, 700]} sizes="(max-width: 480px) 150vw, 700px"
               loading="eager" fetchpriority="high"
               alt="Console murale en chêne massif et acier noir à deux plateaux, réalisée sur mesure" />
        <p class="header-caption">Basé à Sannois, Val d'Oise</p>
    </div>
</header>

<section id="about" aria-labelledby="about-title">
    <div class="container">
        <h2 id="about-title" class="sr-only">Notre démarche</h2>
        <p class="title-2" id="about-text">
            Metal Nature c’est du mobilier artisanal unique conçu avec soin et des matériaux nobles. Nous allions
            menuiserie et métallerie pour fabriquer des meubles à la fois esthétiques et robustes. Nous dédions un
            accompagnement sur mesure à vos projets de leur création à leur installation finale.
        </p>
        <div class="separator" aria-hidden="true"></div>
    </div>

    <div class="about-caption-list">
        <p id="about-caption-1" class="about-caption title-2 strong">Respirez</p>
        <p id="about-caption-2" class="about-caption title-2">Vous êtes encadré</p>
        <p id="about-caption-3" class="about-caption title-2">De votre idée de projet initial</p>
        <p id="about-caption-4" class="about-caption title-2">À sa conception finale</p>
        <p id="about-caption-5" class="about-caption title-2">Nous vous accompagnons</p>
        <p id="about-caption-6" class="about-caption title-2">Nous allions des matériaux robustes à un savoir-faire artisanal</p>
        <p id="about-caption-7" class="about-caption title-2">Pour créer du mobilier fonctionnel qui vous ressemble</p>
        <p id="about-caption-8" class="about-caption title-2">Avec un design à la fois organique et brut</p>
    </div>
    <div class="about-render" data-spline-url="https://prod.spline.design/idrErWFAM5jNCV1n/scene.splinecode" aria-hidden="true"></div>
</section>

<section id="products" class="dark-theme" aria-labelledby="products-title">
    <div class="container">
        <h2 id="products-title" class="sr-only">Nos réalisations</h2>
        <p id="product-caption" class="title-2">
            Depuis plus de cinq ans, nous créons sur mesure le mobilier qui s'intègre parfaitement à votre intérieur.
            Découvrez les projets que nous avons réalisés pour nos clients et imaginez ce que nous pourrions créer pour vous.
        </p>
    </div>

    <div class="carousel-container">
        <ul class="carousel" id="carousel" aria-label="Réalisations">
            {realisations.map((item) => (
                <li class="carousel-item">
                    <a class="carousel-item-button" href={`/realisations/${item.id}/`}
                       data-title={item.data.title}
                       data-caption={item.body?.trim()}
                       data-spline={item.data.splineToken}>
                        <Image src={item.data.image} widths={[300, 600]} sizes="(max-width: 1024px) 300px, 25vw"
                               alt="" loading="lazy" />
                        <span class="carousel-item-caption">
                            <span>{item.data.title}</span>
                            <span>{item.data.year}</span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
        <div class="carousel-action-group">
            <button type="button" id="carouselPrevious" class="carousel-action" aria-controls="carousel" aria-label="Réalisations précédentes">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" />
                </svg>
            </button>
            <button type="button" id="carouselNext" class="carousel-action" aria-controls="carousel" aria-label="Réalisations suivantes">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                </svg>
            </button>
        </div>
    </div>
</section>

<section id="author" aria-labelledby="author-name">
    <p class="scroll-title" aria-hidden="true">
        <span class="part-1">Artisan</span>
        <span class="part-2 strong">Créateur</span>
    </p>
    <article class="container">
        <Image src={portrait} widths={[300, 481]} sizes="(max-width: 768px) 100vw, 300px" loading="lazy"
               alt="Portrait de Michel Valade, menuisier et métallier, fondateur de Metal Nature" />
        <div class="about-quote">
            <h2 id="author-name" class="title-2">Michel Valade, artisan créateur</h2>
            <p>
                Autrefois exclusivement menuisier, Michel a enrichi son parcours en devenant également métallier. Aujourd'hui, il crée des meubles sur mesure, alliant bois et métal avec une délicatesse et une précision admirables. Ses mains expertes donnent vie à des pièces uniques, alliant esthétique et fonctionnalité avec une simplicité touchante.
            </p>
            <p>
                Ce qui distingue Michel, c'est sa capacité à comprendre et à répondre aux besoins de ses clients. Il écoute attentivement leurs souhaits, transformant ces échanges en meubles qui apportent chaleur et singularité à chaque intérieur. Sans chercher la gloire, Michel trouve sa satisfaction dans le sourire de ceux qui découvrent ses œuvres.
            </p>
        </div>
    </article>
</section>

<section id="proposal" aria-labelledby="proposal-title" style={`--proposal-bg: url(${proposalBg.src})`}>
    <div class="container">
        <h2 id="proposal-title" class="sr-only">Ce que nous fabriquons</h2>
        <p id="proposal-caption">
            De la table basse au bureau fonctionnel, en passant par le dressing et la bibliothèque, chaque création est
            pensée pour embellir vos espaces. Nous fabriquons des meubles variés et notre plus grande fierté est de les voir matérialisés chez vous.
        </p>
        <div class="list-group-container">
            <ul class="list-group">
                <li class="list-group-item">Dressings</li>
                <li class="list-group-item">Placards</li>
                <li class="list-group-item">Rangements sous escalier</li>
                <li class="list-group-item">Rangements sous combles</li>
                <li class="list-group-item">Rangements d’entrée</li>
                <li class="list-group-item">Étagères murales</li>
                <li class="list-group-item">Bibliothèques</li>
            </ul>
            <ul class="list-group">
                <li class="list-group-item">Lits</li>
                <li class="list-group-item">Bureaux</li>
                <li class="list-group-item">Tables</li>
                <li class="list-group-item">Tables basses</li>
                <li class="list-group-item">Caissons de bureau</li>
                <li class="list-group-item">Buffets</li>
                <li class="list-group-item">Bancs</li>
            </ul>
        </div>
    </div>
</section>

<section id="contact" class="dark-theme" aria-labelledby="contact-title">
    <div class="container">
        <Image src={contactImage} widths={[360]} loading="lazy" alt="" />
        <div class="contact-group">
            <div>
                <h2 id="contact-title">Un projet à nous <span class="strong">confier ?</span></h2>
                <p class="secondary-text">
                    Contactez-nous — Nous serions ravis de discuter des détails de votre projet et de réaliser
                    gratuitement un devis avec vous.
                </p>
            </div>
            <address class="contact-details">
                <div>
                    <p>Atelier</p>
                    <p class="secondary-text">{SITE.city} ({SITE.postalCode}), {SITE.department}</p>
                </div>
                <div>
                    <p>Courriel</p>
                    <p class="secondary-text"><MailLink /></p>
                </div>
                <div>
                    <p>Téléphone</p>
                    <p class="secondary-text"><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></p>
                </div>
            </address>
            <MailLink class="contact-button" subject="Projet de meuble sur mesure" body={mailBody}>
                Envoyez-nous un mail
            </MailLink>
        </div>
    </div>
</section>
</main>

<!-- Fenêtre de détail d'une réalisation, ouverte depuis le carrousel (scripts/products.ts). -->
<div class="product-details-container" role="dialog" aria-modal="true"
     aria-labelledby="details-name" aria-describedby="details-caption" hidden>
    <button type="button" class="product-details-close-button">Fermer</button>
    <div class="product-caption">
        <div class="product-content" aria-live="polite">
            <h2 id="details-name"></h2>
            <p id="details-caption"></p>
            <a id="details-link" class="details-link" href="/">Voir la fiche complète</a>
        </div>
        <div class="carousel-action-group">
            <button type="button" class="carousel-action details-previous" aria-label="Réalisation précédente">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75L3 12m0 0l3.75-3.75M3 12h18" />
                </svg>
            </button>
            <button type="button" class="carousel-action details-next" aria-label="Réalisation suivante">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                </svg>
            </button>
        </div>
    </div>
    <div class="render-container" aria-hidden="true">
        {realisations.map(() => <div class="product-render"></div>)}
    </div>
</div>

<SiteFooter />

<script>
    import { initHomePage } from '../scripts/home';
    initHomePage();
</script>
</BaseLayout>
