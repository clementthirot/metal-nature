---
import { withBase } from '../utils/paths';
import { getCollection } from 'astro:content';
import { Image, Picture, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MailLink from '../components/MailLink.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { SITE, FURNITURE_GROUPS } from '../site';
import { BUSINESS_ID } from '../utils/seo';
import '../styles/home.css';

import headerImage from '../assets/images/header.png';
import contactImage from '../assets/images/contact.png';
import portrait from '../assets/images/portrait-michel-valade-artisan-metal-bois.webp';
import proposalBackground from '../assets/images/atelier-fond.jpg';
import aboutPoster from '../assets/realisations/meuble-metal-bois-bibliotheque.png';
import stillTables from '../assets/realisations/meuble-metal-table-basse-imbriquee.png';
import stillCommode from '../assets/realisations/meuble-metal-commode-arquee.png';

const realisations = (await getCollection('realisations', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);
// Image affichée dans la fenêtre de détail en attendant (ou à la place de) la scène 3D.
const posters = await Promise.all(realisations.map((item) => getImage({ src: item.data.image, format: 'webp', width: 360 })));
// B8 : aperçu flou (LQIP) affiché sous chaque carte tant que la photo n'est pas chargée.
const placeholders = await Promise.all(realisations.map((item) => getImage({ src: item.data.image, format: 'webp', width: 16, quality: 40 })));

// Lot 3 : cotes réelles des meubles de la séquence 3D, lues dans le champ `dimensions` des réalisations
// (« 300 × 210 × 60 cm (L × H × P) »). Sans dimensions connues, la cote affiche « sur mesure ».
const toMm = (dimensions?: string) => {
    const match = dimensions?.match(/([\d.,]+)\s*×\s*([\d.,]+)(?:\s*×\s*([\d.,]+))?\s*(mm|cm|m)\b/);
    if (!match) return { width: null, height: null, depth: null };
    const factor = match[4] === 'm' ? 1000 : match[4] === 'cm' ? 10 : 1;
    const value = (raw?: string) => (raw ? Math.round(parseFloat(raw.replace(',', '.')) * factor) : null);
    return { width: value(match[1]), height: value(match[2]), depth: value(match[3]) };
};
const byModel = (model: string) => toMm(realisations.find((item) => item.data.model === model)?.data.dimensions);
const sceneSizes = {
    shelf: byModel('bibliotheque'),
    tables: byModel('tables-basses-imbriquees'),
    commode: byModel('commode-arquee'),
};

// Données structurées de l'entreprise (audit SEO, P1.7). L'adresse de rue n'est ajoutée que si
// SITE.showStreetAddress est activé (à décider avec Michel, pour une adresse identique partout).
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'HomeAndConstructionBusiness',
    '@id': BUSINESS_ID,
    name: SITE.name,
    description: 'Création de meubles artisanaux sur mesure en bois et métal, de la conception à l’installation.',
    url: `${SITE.url}/`,
    image: `${SITE.url}/og-image.jpg`,
    logo: `${SITE.url}/logo-metal-nature.svg`,
    telephone: SITE.phone,
    priceRange: 'Sur devis',
    openingHours: SITE.openingHours,
    founder: {
        '@type': 'Person',
        name: SITE.owner,
        jobTitle: 'Menuisier et métallier',
        knowsAbout: ['Menuiserie', 'Métallerie', 'Mobilier sur mesure'],
    },
    address: {
        '@type': 'PostalAddress',
        ...(SITE.showStreetAddress ? { streetAddress: SITE.streetAddress } : {}),
        addressLocality: SITE.city,
        postalCode: SITE.postalCode,
        addressRegion: SITE.region,
        addressCountry: 'FR',
    },
    areaServed: [
        { '@type': 'City', name: SITE.city },
        { '@type': 'AdministrativeArea', name: "Val-d'Oise" },
        { '@type': 'AdministrativeArea', name: SITE.region },
    ],
    knowsAbout: ['Menuiserie', 'Métallerie', 'Mobilier sur mesure', 'Bibliothèque sur mesure', 'Dressing sur mesure'],
    ...(SITE.sameAs.length ? { sameAs: SITE.sameAs } : {}),
};

const mailBody = "Bonjour Michel,\n\nJ'aimerais un devis pour le projet suivant :\n\nType de meuble :\nPièce :\nDimensions approximatives :\nMatériaux souhaités :\n\nVous pouvez me rappeler au :\n\nCordialement";
---
<BaseLayout
    title="Meubles sur mesure bois et métal à Sannois (95) | Metal Nature"
    description="Meubles sur mesure en bois et métal fabriqués à Sannois (95) pour toute l'Île-de-France : dressings, bibliothèques, tables. Devis gratuit."
    jsonLd={jsonLd}
    bodyClass="page-home"
>

<SiteNav />

<main id="main">
<!-- ============================ HERO ============================ -->
<header id="home" class="hero container has-grid">
    <h1 class="sr-only">Metal Nature, meubles artisanaux sur mesure en bois et métal à Sannois (Val d'Oise)</h1>
    <p class="hero-title display" aria-hidden="true">
        <span class="hero-line"><span class="title-line">La touche <span class="strong">authentique</span></span></span>
        <span class="hero-line"><span class="title-line">à votre intérieur</span></span>
    </p>
    <div class="hero-content grid-layout">
        <a class="hero-caption tap-link" href="#about">Faites défiler <span aria-hidden="true">↓</span></a>
        <div class="hero-media">
            <Picture id="headerImage" src={headerImage} formats={['avif', 'webp']} widths={[350, 520, 700]}
                     sizes="(max-width: 768px) calc(100vw - 32px), (max-width: 1024px) 60vw, 640px"
                     loading="eager" fetchpriority="high"
                     alt="Console murale en chêne massif et acier noir à deux plateaux, réalisée sur mesure" />
        </div>
        <p class="hero-caption hero-caption-end">Basé à Sannois, Val d'Oise</p>
    </div>
</header>

<!-- ======================= NOTRE DÉMARCHE ======================= -->
<section id="about" class="about has-grid" aria-labelledby="about-title">
    <div class="container about-intro">
        <h2 id="about-title" class="eyebrow">Menuiserie et métallerie sur mesure</h2>
        <p class="statement split-lines" id="about-text">
            Metal Nature, c’est du mobilier <span class="strong">artisanal et unique</span>, conçu avec soin dans des
            matériaux nobles. Nous allions menuiserie et métallerie pour fabriquer des meubles à la fois beaux et
            robustes, et nous vous accompagnons de l’idée à l’installation.
        </p>
        <hr class="rule separator" aria-hidden="true" />
        <a class="tap-link about-skip" href="#products">Passer à nos réalisations <span aria-hidden="true">↓</span></a>
    </div>

    <div class="about-pin">
        <!-- Lot 3 : la scène 3D couvre toute la largeur de l'écran ; la grille devient le sol de la scène.
             data-sizes : cotes réelles des meubles (mm), affichées en lignes de cote. -->
        <div class="about-visual" data-sizes={JSON.stringify(sceneSizes)}>
            <Picture class="model-poster" src={aboutPoster} formats={['avif', 'webp']} widths={[360]} sizes="360px"
                     loading="lazy" alt="" />
            <svg class="about-dims" aria-hidden="true"></svg>
        </div>
        <div class="container about-stage grid-layout">
            <!-- data-progress-start / data-progress-end : plage (0 → 1) de la section où le message est affiché,
                 alignée sur les phases de la scène 3D (scripts/about-scene.ts, PHASES).
                 Le texte est posé sans voile : il s'inverse en négatif au-dessus des meubles (mix-blend-mode).
                 Les images .about-step-still ne s'affichent qu'avec « réduire les animations ». -->
            <ol class="about-steps">
                <li class="about-step about-step-intro" data-progress-start="0" data-progress-end="0.12">
                    <span class="title-2">Respirez, <span class="strong">vous êtes bien accompagné.</span></span>
                </li>
                <li class="about-step" data-progress-start="0.12" data-progress-end="0.3">
                    <span class="about-step-number mono" aria-hidden="true">01 / Conception</span>
                    <span class="title-2">De votre idée à son installation, <span class="strong">nous vous accompagnons.</span></span>
                </li>
                <li class="about-step" data-progress-start="0.3" data-progress-end="0.45">
                    <span class="about-step-number mono" aria-hidden="true">02 / Matériaux</span>
                    <span class="title-2">Des matériaux robustes, <span class="strong">un savoir-faire artisanal.</span></span>
                    <Picture class="about-step-still" src={aboutPoster} formats={['avif', 'webp']} widths={[360]} sizes="240px"
                             loading="lazy" alt="Bibliothèque en bois et métal réalisée par Metal Nature" />
                </li>
                <li class="about-step" data-progress-start="0.45" data-progress-end="0.72">
                    <span class="about-step-number mono" aria-hidden="true">03 / Fonction</span>
                    <span class="title-2">Un mobilier fonctionnel, <span class="strong">qui vous ressemble.</span></span>
                    <Picture class="about-step-still" src={stillTables} formats={['avif', 'webp']} widths={[360]} sizes="240px"
                             loading="lazy" alt="Tables basses emboîtées en métal réalisées par Metal Nature" />
                </li>
                <li class="about-step" data-progress-start="0.72" data-progress-end="1">
                    <span class="about-step-number mono" aria-hidden="true">04 / Design</span>
                    <span class="title-2">Un design à la fois <span class="strong">organique et brut.</span></span>
                    <Picture class="about-step-still" src={stillCommode} formats={['avif', 'webp']} widths={[360]} sizes="240px"
                             loading="lazy" alt="Commode arquée en métal chromé réalisée par Metal Nature" />
                </li>
            </ol>
            <div class="about-progress" aria-hidden="true"><span class="about-progress-bar"></span></div>
        </div>
    </div>
</section>

<!-- ======================== RÉALISATIONS ======================== -->
<section id="products" class="products dark-theme has-grid" data-tempo="1.8" aria-labelledby="products-title">
    <div class="container products-intro">
        <h2 id="products-title" class="eyebrow">Nos réalisations de meubles sur mesure</h2>
        <p id="product-caption" class="statement split-lines">
            Depuis plus de cinq ans, nous créons <span class="strong">sur mesure</span> le mobilier qui s'intègre
            parfaitement à votre intérieur. Découvrez nos projets et imaginez ce que nous
            pourrions créer pour vous.
        </p>
    </div>

    <div class="carousel-container">
        <!-- Fenêtre du carrousel : exactement la largeur de la grille, rien ne dépasse des lignes. -->
        <div class="carousel-viewport">
        <ul class="carousel" id="carousel" aria-label="Réalisations">
            {realisations.map((item, index) => (
                <li class="carousel-item">
                    <a class="carousel-item-button" href={withBase(`/realisations/${item.id}/`)}
                       data-title={item.data.title}
                       data-caption={item.body?.trim()}
                       data-model={item.data.model}
                       data-poster={posters[index].src}
                       data-poster-alt={item.data.imageAlt}>
                        {/* alt descriptif (audit SEO) : décrit la photo, complète le nom affiché dessous */}
                        <span class="sketch card-media" data-sketch style={`--lqip: url(${placeholders[index].src})`}>
                            <Picture src={item.data.image} formats={['avif', 'webp']} widths={[300, 360]}
                                     sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 1024px) 33vw, 300px" alt={item.data.imageAlt}
                                     loading={index < 4 ? 'eager' : 'lazy'} />
                            <span class="card-blueprint" aria-hidden="true" style={`--photo: url(${posters[index].src})`}></span>
                        </span>
                        <span class="carousel-item-caption">
                            <span>{item.data.title}<span class="sr-only">, </span></span>
                            <span class="mono">{item.data.year}</span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
        </div>
        <div class="container carousel-footer">
            <div class="carousel-action-group">
                <button type="button" id="carouselPrevious" class="carousel-action" aria-controls="carousel" aria-label="Réalisations précédentes">
                    <ArrowIcon direction="left" />
                </button>
                <button type="button" id="carouselNext" class="carousel-action" aria-controls="carousel" aria-label="Réalisations suivantes">
                    <ArrowIcon direction="right" />
                </button>
            </div>
            <a class="tap-link" href={withBase('/realisations/')}>Voir toutes les réalisations</a>
        </div>
    </div>
</section>

<!-- =========================== ARTISAN ========================== -->
<section id="author" class="author has-grid" aria-labelledby="author-name">
    <p class="scroll-title" aria-hidden="true">
        <span class="part-1">Artisan</span>
        <span class="part-2">Créateur</span>
    </p>
    <article class="container author-card grid-layout">
        <span class="sketch sketch-square author-portrait" data-sketch>
            <Picture src={portrait} formats={['avif', 'webp']} widths={[320, 481]} sizes="(max-width: 640px) calc(100vw - 32px), 300px" loading="lazy" data-loupe
                     alt="Portrait de Michel Valade, menuisier et métallier, fondateur de Metal Nature" />
        </span>
        <div class="about-quote prose">
            <h2 id="author-name" class="title-2">Michel Valade, artisan créateur</h2>
            <p>
                Autrefois exclusivement menuisier, Michel a enrichi son parcours en devenant également métallier. Aujourd'hui, il crée des meubles sur mesure, alliant bois et métal avec une délicatesse et une précision admirables. Ses mains expertes donnent vie à des pièces uniques, alliant esthétique et fonctionnalité avec une simplicité touchante.
            </p>
            <p>
                Ce qui distingue Michel, c'est sa capacité à comprendre et à répondre aux besoins de ses clients. Il écoute attentivement leurs souhaits, transformant ces échanges en meubles qui apportent chaleur et singularité à chaque intérieur. Sans chercher la gloire, Michel trouve sa satisfaction dans le sourire de ceux qui découvrent ses œuvres.
            </p>
        </div>
    </article>
</section>

<!-- ===================== CE QUE NOUS FABRIQUONS ==================== -->
<section id="proposal" class="proposal has-grid" aria-labelledby="proposal-title">
    <span class="sketch sketch-square proposal-bg-frame" data-sketch>
        <Image class="proposal-bg" src={proposalBackground} widths={[800, 1600]} sizes="100vw" format="webp"
               loading="lazy" alt="L'atelier de Metal Nature à Sannois : machines à bois, établi et outillage" />
    </span>
    <div class="container">
        <div class="proposal-card bleed">
            <h2 id="proposal-title" class="eyebrow">Les meubles que nous fabriquons</h2>
            <p id="proposal-caption" class="statement split-lines">
                De la table basse au bureau, en passant par le dressing et la bibliothèque, chaque création est pensée
                pour <span class="strong">embellir vos espaces.</span>
            </p>
            <p class="proposal-caption prose">
                Nous fabriquons des meubles variés, et notre plus grande fierté est de les voir prendre place chez vous.
                Votre projet n'est pas dans la liste ? Parlons-en.
            </p>
            <!-- Familles de meubles (audit SEO, P1) : un H3 par famille, relié à sa page service. -->
            <ol class="furniture-groups">
                {FURNITURE_GROUPS.map((group, index) => (
                    <li class="furniture-group">
                        <h3 class="furniture-group-title">
                            <span class="list-group-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                            {group.service
                                ? <a href={withBase(`/meubles-sur-mesure/${group.service}/`)}>{group.title}</a>
                                : <span>{group.title}</span>}
                        </h3>
                        <p class="furniture-group-text">{group.text}</p>
                        <ul class="furniture-group-items">
                            {group.items.map((item) => <li>{item}</li>)}
                        </ul>
                    </li>
                ))}
            </ol>
            <a class="button proposal-cta" href="#contact">Parler de mon projet</a>
        </div>
    </div>
</section>

<!-- =========================== CONTACT ========================== -->
<section id="contact" class="contact dark-theme has-grid" aria-labelledby="contact-title">
    <div class="container contact-heading">
        <h2 id="contact-title" class="statement">Un projet à nous <span class="strong">confier ?</span></h2>
    </div>
    <div class="container contact-grid grid-layout">
        <div class="contact-group">

            <!-- Le téléphone d'abord (lot B) : Michel préfère échanger de vive voix. -->
            <div class="contact-call">
                <a class="button button-call" href={`tel:${SITE.phone}`}>
                    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    <span>Appeler Michel <span class="button-call-number">{SITE.phoneDisplay}</span></span>
                </a>
                <p class="secondary-text">
                    {SITE.callHours && <>Joignable {SITE.callHours}. </>}Pas de réponse ? Laissez un message, Michel vous rappelle.
                </p>
            </div>

            <ul class="reassurance" aria-label="Nos engagements">
                <li><span><strong>Un appel suffit</strong> pour un premier échange</span></li>
                <li><span><strong>Devis gratuit</strong> et sans engagement</span></li>
                <li><span><strong>Intervention</strong> à {SITE.areaServed}</span></li>
            </ul>

            <div class="contact-secondary">
                <p class="secondary-text">Vous préférez écrire ?</p>
                <MailLink class="button button-ghost" subject="Projet de meuble sur mesure" body={mailBody}>Écrire à Michel</MailLink>
            </div>

            <address class="contact-details">
                <div>
                    <p class="contact-label">Atelier</p>
                    <p class="contact-value">{SITE.city} ({SITE.postalCode}), {SITE.department}</p>
                </div>
            </address>
        </div>
        <Picture class="contact-image" src={contactImage} formats={['avif', 'webp']} widths={[360]}
                 sizes="(max-width: 768px) calc(100vw - 32px), 600px" loading="lazy"
                 alt="Bibliothèque en bois et métal fabriquée sur mesure par Metal Nature" />
    </div>
</section>
</main>

<!-- Fenêtre de détail d'une réalisation, ouverte depuis le carrousel (scripts/products.ts). -->
<div class="product-details-container" role="dialog" aria-modal="true"
     aria-labelledby="details-name" aria-describedby="details-caption" hidden>
    <button type="button" class="product-details-close-button button">Fermer</button>
    <div class="product-details-layout">
        <!-- Pas d'aria-hidden ici : la zone contient le bouton « Voir en 3D » (focusable). Le canvas est masqué seul. -->
        <div class="product-stage">
            <img class="product-poster" alt="" />
            <div class="product-skeleton"><span>Chargement de la vue 3D…</span></div>
            <button type="button" class="button button-ghost model-trigger" hidden>Voir en 3D</button>
        </div>
        <div class="product-caption">
            <div class="product-content" aria-live="polite">
                <h2 id="details-name" class="title-2">{realisations[0]?.data.title}</h2>
                <p id="details-caption">{realisations[0]?.body?.trim()}</p>
                <a id="details-link" class="tap-link" href={withBase('/realisations/')}>Voir la fiche complète</a>
            </div>
            <div class="carousel-action-group">
                <button type="button" class="carousel-action details-previous" aria-label="Réalisation précédente">
                    <ArrowIcon direction="left" />
                </button>
                <button type="button" class="carousel-action details-next" aria-label="Réalisation suivante">
                    <ArrowIcon direction="right" />
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Lot 4 : filtre « dessin technique » des cartes (contours clairs sur fond d'encre). -->
<svg class="sr-only" aria-hidden="true" focusable="false">
    <filter id="blueprint-edges" color-interpolation-filters="sRGB" x="0" y="0" width="100%" height="100%">
        <feColorMatrix type="saturate" values="0" result="gray" />
        <feConvolveMatrix in="gray" order="3" kernelMatrix="-1 -1 -1 -1 8 -1 -1 -1 -1" preserveAlpha="true" result="edges" />
        <feColorMatrix in="edges" type="matrix" result="lines"
                       values="0 0 0 0 0.93  0 0 0 0 0.94  0 0 0 0 0.95  2.2 2.2 2.2 0 -0.08" />
        <feFlood flood-color="#141618" result="ink" />
        <feComposite in="lines" in2="ink" operator="over" />
    </filter>
</svg>

<SiteFooter />

<script>
    import { initHomePage } from '../scripts/home';
    initHomePage();
</script>
</BaseLayout>
